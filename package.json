{
  "name": "@tenkicloud/agentbox-provider",
  "version": "0.3.1",
  "description": "Luxor Sandbox provider plugin for AgentBox: run coding agents in Luxor Agent Cloud VMs",
  "license": "MIT",
  "author": "Luxor Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agentbox",
    "agentbox-provider",
    "provider",
    "plugin",
    "luxor",
    "luxorai",
    "luxor-sandbox",
    "luxor-agent-cloud",
    "sandbox",
    "vm",
    "coding-agent",
    "tenki"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuxorLabs/tenki-agentbox-provider.git"
  },
  "homepage": "https://luxor.ai",
  "bugs": {
    "url": "https://github.com/LuxorLabs/tenki-agentbox-provider/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "agentbox": {
    "providerApiVersion": 4
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:package": "node scripts/validate-package.mjs",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "check:changelog": "node scripts/check-changelog.mjs"
  },
  "dependencies": {
    "@madarco/agentbox-provider-sdk": "^4",
    "@tenkicloud/sandbox": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
